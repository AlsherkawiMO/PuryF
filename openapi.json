{
  "openapi": "3.1.0",
  "info": {
    "title": "PuryF local/hosted preview API",
    "version": "0.5.0-alpha.1",
    "description": "Loopback by default. Hosted inputs are upload IDs; local inputs are permitted absolute paths. Poll job status for progress."
  },
